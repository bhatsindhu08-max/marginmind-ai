# ==========================================
# MarginMind AI - Environment Configuration
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="MarginMind AI"
API_V1_STR=/api/v1

# Security & Authentication
SECRET_KEY=replace_this_with_a_secure_random_32_character_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Database Configuration
# For local SQLite development:
DATABASE_URL=sqlite:///./marginmind.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://marginmind_user:marginmind_secret_2026@localhost:5432/marginmind_prod

# PostgreSQL Service (Docker Compose)
POSTGRES_USER=marginmind_user
POSTGRES_PASSWORD=marginmind_secret_2026
POSTGRES_DB=marginmind_prod

# Demonstration Mode
# When true, automatically provisions the "Apex Precision Forging & Fabrication Ltd." seed dataset
DEMO_MODE=true

# External Market Intelligence Connectors
# World Bank Pink Sheet Open API (No key required for public endpoints)
WORLDBANK_API_BASE=https://api.worldbank.org/v2
# RBI DBIE / WPI / CBIC Gazette Scraping Interval (Hours)
MARKET_FEED_SYNC_HOURS=24
# Live API Fallback Flag (Defaults to verified historical series if offline)
ALLOW_OFFLINE_MOCK_FALLBACK=true

# File Storage Paths
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports

# Optional LLM Structured Document Extraction (Gemini API)
# If provided, high-accuracy multi-modal OCR will extract structured fields from scanned PDFs
GEMINI_API_KEY=
